{
  "name": "sagshub",
  "version": "1.0.0",
  "description": "SagsHub Case Management System",
  "scripts": {
    "dev:backend": "cd server && npm run dev",
    "dev:frontend": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install && cd ../shared && npm install",
    "build": "cd client && npm run build",
    "start:backend": "cd server && npm start",
    "start:frontend": "cd client && npm run preview"
  },
  "keywords": [
    "case-management",
    "repair-shop",
    "typescript",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express-session": "^1.18.2",
    "@types/faker": "^6.6.8",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.15",
    "@types/pg": "^8.15.4",
    "@types/ws": "^8.18.1",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.44.3",
    "express-session": "^1.18.2",
    "jest": "^30.0.4",
    "jsonwebtoken": "^9.0.2",
    "kill-port": "^2.0.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "winston": "^3.17.0",
    "ws": "^8.18.3",
    "zod": "^4.0.5"
  }
}
