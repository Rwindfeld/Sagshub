{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    
    "outDir": "./dist",
    "rootDir": "./",
    "declaration": true,
    "declarationMap": true,
    
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  
  "include": [
    "**/*.ts"
  ],
  
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
} 