# =============================================================================
# SAGSHUB MILJØVARIABLER EKSEMPEL FIL
# =============================================================================
# Denne fil viser eksempler på alle miljøvariabler som SagsHub systemet bruger.
# Kopiér denne fil til .env og tilpas værdierne til dit miljø.
# VIGTIGT: Tilføj aldrig rigtige credentials til version control!
# =============================================================================

# =================================================================
# DATABASE KONFIGURATION
# =================================================================
# PostgreSQL database forbindelsesindstillinger

DB_HOST=localhost                                              # Database server adresse (localhost for local development)
DB_PORT=5432                                                   # PostgreSQL port (default: 5432)
DB_NAME=sagshub                                                # Database navn
DB_USER=postgres                                               # Database brugernavn
DB_PASSWORD=wa2657321                                          # Database password (SKIFT I PRODUCTION!)

# =================================================================
# SERVER KONFIGURATION  
# =================================================================
# Backend server indstillinger

PORT=5000                                                      # Port som Express serveren lytter på
NODE_ENV=development                                           # Miljø: development, staging, production

# =================================================================
# SESSION SIKKERHED
# =================================================================
# Sikkerhedsindstillinger til session management

SESSION_SECRET=your-super-secret-session-key-change-this       # Session encryption key (SKAL ændres i production!)
# Generér en stærk, tilfældig nøgle i production med: openssl rand -base64 32

# =================================================================
# CORS KONFIGURATION
# =================================================================
# Cross-Origin Resource Sharing indstillinger

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173    # Tilladte frontend origins (komma-separeret)
# I production: https://yourdomain.com

# =================================================================
# LOGGING KONFIGURATION
# =================================================================
# Log niveau og output indstillinger

LOG_LEVEL=info                                                 # Log niveau: error, warn, info, debug
LOG_FILE=logs/sagshub.log                                      # Sti til log fil (optional)

# Server konfiguration
HOST=0.0.0.0

# Netværk konfiguration
# Sæt til din computers IP-adresse for at tillade eksterne forbindelser
# Eksempel: EXTERNAL_HOST=192.168.1.100
EXTERNAL_HOST=localhost

# Frontend URL (bruges til CORS)
FRONTEND_URL=http://localhost:5174 